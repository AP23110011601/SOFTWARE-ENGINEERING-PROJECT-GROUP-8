import React, { createContext, useContext, useState, useEffect, useCallback } from 'react';
import { 
  Bell, 
  CheckCircle, 
  AlertTriangle, 
  X, 
  Info, 
  AlertCircle,
  Wifi,
  WifiOff,
  Cloud,
  CloudRain,
  Thermometer,
  Droplets,
  Zap,
  TrendingUp,
  TrendingDown
} from 'lucide-react';

const NotificationContext = createContext();

export const useNotifications = () => {
  const context = useContext(NotificationContext);
  if (!context) {
    throw new Error('useNotifications must be used within a NotificationProvider');
  }
  return context;
};

export const NotificationProvider = ({ children }) => {
  const [notifications, setNotifications] = useState([]);
  const [unreadCount, setUnreadCount] = useState(0);

  // Auto-remove notifications after 5 seconds
  useEffect(() => {
    const timer = setInterval(() => {
      setNotifications(prev => {
        const now = Date.now();
        return prev.filter(notification => 
          now - notification.timestamp < 5000 || notification.persistent
        );
      });
    }, 1000);

    return () => clearInterval(timer);
  }, []);

  // Update unread count
  useEffect(() => {
    setUnreadCount(notifications.filter(n => !n.read).length);
  }, [notifications]);

  const addNotification = useCallback((notification) => {
    const newNotification = {
      id: Date.now() + Math.random(),
      timestamp: Date.now(),
      read: false,
      persistent: false,
      ...notification
    };

    setNotifications(prev => [newNotification, ...prev]);

    // Auto-mark as read after 3 seconds for non-persistent notifications
    if (!newNotification.persistent) {
      setTimeout(() => {
        markAsRead(newNotification.id);
      }, 3000);
    }

    return newNotification.id;
  }, []);

  const removeNotification = useCallback((id) => {
    setNotifications(prev => prev.filter(n => n.id !== id));
  }, []);

  const markAsRead = useCallback((id) => {
    setNotifications(prev => prev.map(n => 
      n.id === id ? { ...n, read: true } : n
    ));
  }, []);

  const markAllAsRead = useCallback(() => {
    setNotifications(prev => prev.map(n => ({ ...n, read: true })));
  }, []);

  const clearAll = useCallback(() => {
    setNotifications([]);
  }, []);

  // Predefined notification types
  const notificationTypes = {
    success: (message, options = {}) => addNotification({
      type: 'success',
      title: 'Success',
      message,
      icon: CheckCircle,
      color: 'text-green-600 bg-green-100 border-green-200',
      ...options
    }),

    error: (message, options = {}) => addNotification({
      type: 'error',
      title: 'Error',
      message,
      icon: AlertCircle,
      color: 'text-red-600 bg-red-100 border-red-200',
      persistent: true,
      ...options
    }),

    warning: (message, options = {}) => addNotification({
      type: 'warning',
      title: 'Warning',
      message,
      icon: AlertTriangle,
      color: 'text-yellow-600 bg-yellow-100 border-yellow-200',
      ...options
    }),

    info: (message, options = {}) => addNotification({
      type: 'info',
      title: 'Information',
      message,
      icon: Info,
      color: 'text-blue-600 bg-blue-100 border-blue-200',
      ...options
    }),

    // Smart Agriculture specific notifications
    irrigation: (message, zone) => addNotification({
      type: 'irrigation',
      title: 'Irrigation Alert',
      message,
      icon: Droplets,
      color: 'text-blue-600 bg-blue-100 border-blue-200',
      zone,
      action: 'View Irrigation',
      ...options
    }),

    weather: (message, type = 'info') => addNotification({
      type: 'weather',
      title: 'Weather Update',
      message,
      icon: type === 'rain' ? CloudRain : Cloud,
      color: type === 'rain' ? 'text-gray-600 bg-gray-100 border-gray-200' : 'text-blue-600 bg-blue-100 border-blue-200',
      ...options
    }),

    sensor: (message, sensor, value) => addNotification({
      type: 'sensor',
      title: 'Sensor Alert',
      message,
      icon: sensor === 'temperature' ? Thermometer : Droplets,
      color: 'text-orange-600 bg-orange-100 border-orange-200',
      sensor,
      value,
      ...options
    }),

    disease: (message, crop) => addNotification({
      type: 'disease',
      title: 'Disease Detection',
      message,
      icon: AlertTriangle,
      color: 'text-red-600 bg-red-100 border-red-200',
      crop,
      action: 'View Details',
      persistent: true,
      ...options
    }),

    system: (message, status = 'info') => addNotification({
      type: 'system',
      title: 'System Update',
      message,
      icon: status === 'online' ? Wifi : WifiOff,
      color: status === 'online' ? 'text-green-600 bg-green-100 border-green-200' : 'text-red-600 bg-red-100 border-red-200',
      ...options
    }),

    performance: (message, trend) => addNotification({
      type: 'performance',
      title: 'Performance Alert',
      message,
      icon: trend === 'up' ? TrendingUp : TrendingDown,
      color: trend === 'up' ? 'text-green-600 bg-green-100 border-green-200' : 'text-red-600 bg-red-100 border-red-200',
      ...options
    })
  };

  const value = {
    notifications: notifications.filter(n => Date.now() - n.timestamp < 5000 || n.persistent),
    allNotifications: notifications,
    unreadCount,
    addNotification,
    removeNotification,
    markAsRead,
    markAllAsRead,
    clearAll,
    notificationTypes: notificationTypes
  };

  return (
    <NotificationContext.Provider value={value}>
      {children}
    </NotificationContext.Provider>
  );
};

const NotificationItem = ({ notification, onRemove, onMarkAsRead }) => {
  const [isLeaving, setIsLeaving] = useState(false);

  const handleRemove = () => {
    setIsLeaving(true);
    setTimeout(() => onRemove(notification.id), 300);
  };

  const Icon = notification.icon || Info;

  return (
    <div
      className={`
        relative flex items-start p-4 rounded-lg border shadow-lg
        transform transition-all duration-300 ease-in-out
        ${notification.color}
        ${isLeaving ? 'translate-x-full opacity-0' : 'translate-x-0 opacity-100'}
        ${!notification.read ? 'ring-2 ring-blue-500 ring-opacity-50' : ''}
      `}
    >
      <div className="flex-shrink-0">
        <Icon className="w-5 h-5" />
      </div>
      
      <div className="ml-3 flex-1">
        <div className="flex items-center justify-between">
          <h4 className="text-sm font-semibold">{notification.title}</h4>
          <div className="flex items-center space-x-2">
            {!notification.read && (
              <button
                onClick={() => onMarkAsRead(notification.id)}
                className="text-xs text-blue-600 hover:text-blue-800"
              >
                Mark as read
              </button>
            )}
            <button
              onClick={handleRemove}
              className="text-gray-400 hover:text-gray-600 transition-colors"
            >
              <X className="w-4 h-4" />
            </button>
          </div>
        </div>
        
        <p className="text-sm text-gray-700 mt-1">{notification.message}</p>
        
        {notification.action && (
          <button
            className="mt-2 text-xs font-medium text-blue-600 hover:text-blue-800"
            onClick={() => {
              // Handle action click
              console.log('Action clicked:', notification.action);
            }}
          >
            {notification.action}
          </button>
        )}
        
        <div className="flex items-center justify-between mt-2">
          <span className="text-xs text-gray-500">
            {new Date(notification.timestamp).toLocaleTimeString()}
          </span>
          
          {notification.zone && (
            <span className="text-xs bg-white bg-opacity-50 px-2 py-1 rounded">
              Zone {notification.zone}
            </span>
          )}
          
          {notification.sensor && (
            <span className="text-xs bg-white bg-opacity-50 px-2 py-1 rounded">
              {notification.sensor}: {notification.value}
            </span>
          )}
        </div>
      </div>
      
      {/* Progress bar for auto-dismiss */}
      {!notification.persistent && (
        <div className="absolute bottom-0 left-0 h-1 bg-blue-500 animate-pulse"
          style={{
            width: `${Math.max(0, 100 - ((Date.now() - notification.timestamp) / 50))}%`,
            transition: 'width 0.1s linear'
          }}
        />
      )}
    </div>
  );
};

export const NotificationContainer = () => {
  const { notifications, removeNotification, markAsRead } = useNotifications();

  return (
    <div className="fixed top-4 right-4 z-50 space-y-2 max-w-sm">
      {notifications.map(notification => (
        <NotificationItem
          key={notification.id}
          notification={notification}
          onRemove={removeNotification}
          onMarkAsRead={markAsRead}
        />
      ))}
    </div>
  );
};

export default NotificationProvider;
